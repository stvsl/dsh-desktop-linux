@@ -0,0 +1,55 @@
+/** Credential-free IPC types shared by the settings window and its sandboxed preload. */
+import type { ClientAppearance, ClientAppearanceProblem } from './client-appearance.ts'
+
+/** Channels are private to the independent appearance window, not the product shell. */
+export const CLIENT_SETTINGS_IPC = Object.freeze({
+  get: 'dsh:client-settings:get',
+  save: 'dsh:client-settings:save',
+  restart: 'dsh:client-settings:restart',
+})
+
+/** Renderer-owned message keys, also used by the native restart confirmation. */
+export const CLIENT_SETTINGS_MESSAGE_KEYS = [
+  'title', 'subtitle', 'windowGroup', 'cornerRadius', 'cornerHelp', 'cornerValue', 'shadow', 'shadowHelp',
+  'sidebarGroup', 'glass', 'glassHelp', 'transparency', 'transparencyHelp', 'transparencyValue', 'opaque', 'transparent',
+  'advanced', 'frameless', 'framelessHelp', 'blur', 'blurHelp', 'environmentHelp', 'privacyHelp', 'restartHelp',
+  'runningLabel', 'savedLabel', 'snapshotTemplate', 'on', 'off', 'restore', 'save', 'saveRestart', 'saving', 'restarting',
+  'loading', 'retry', 'unchanged', 'edited', 'defaultsRestored', 'saved', 'savedRestart', 'restartCancelled',
+  'restartTitle', 'restartMessage', 'restartDetail', 'restartConfirm', 'cancel', 'radiusInvalid', 'transparencyInvalid',
+  'errorJson', 'errorDocument', 'errorVersion', 'errorFields', 'errorRead', 'errorWrite', 'errorResources', 'errorBusy',
+  'errorClosed', 'errorRestart', 'errorUnexpected',
+] as const
+
+/** Localized copy comes only from renderer/client-settings/messages.json. */
+export type ClientSettingsMessages = Readonly<Record<typeof CLIENT_SETTINGS_MESSAGE_KEYS[number], string>>
+
+/** Failures sent to the renderer contain no stack, file contents, environment or credentials. */
+export type ClientSettingsProblem = ClientAppearanceProblem
+  | { readonly kind: 'resources' | 'busy' | 'closed' | 'restart' | 'unexpected' }
+
+/** The current run remains fixed while saved values apply to the next application launch. */
+export interface ClientSettingsSnapshot {
+  readonly current: ClientAppearance
+  readonly saved: ClientAppearance
+  readonly defaults: ClientAppearance
+  readonly restartRequired: boolean
+}
+
+/** Structured failures keep their classification across Electron's serialization. */
+export type ClientSettingsReply<T> = {
+  readonly locale: 'zh-CN' | 'en'
+  readonly messages: ClientSettingsMessages
+} & ({ readonly kind: 'ok'; readonly value: T } | { readonly kind: 'error'; readonly problem: ClientSettingsProblem })
+
+/** Only these three operations are exposed in the isolated document. */
+export interface ClientSettingsApi {
+  /** @returns Current and saved values; no runtime appearance changes occur. */
+  get(): Promise<ClientSettingsReply<ClientSettingsSnapshot>>
+  /**
+   * @param value - Complete six-field preferences, strictly validated in the main process.
+   * @returns Saved state or a structured failure; the caller retains its form on failure.
+   */
+  save(value: unknown): Promise<ClientSettingsReply<ClientSettingsSnapshot>>
+  /** @returns Whether the main-process confirmation authorized restart; cancellation never restarts. */
+  restart(): Promise<ClientSettingsReply<{ readonly restarted: boolean }>>
+}
