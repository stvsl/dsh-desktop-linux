+        try:
+            self.assertTrue(relay.state.may_inject_fds())
+            relay.inputs[client].received_fd_count = 1
+            self.assertFalse(relay.state.may_inject_fds())
+            relay.state.client(message(1, 1, words(2)))
+            relay.state.client(bind(2, 40, 'wl_shm', 3))
+            relay.state.client(message(3, 0, words(4, 9600)))
+            self.assertEqual(relay.state.expected_client_fds, 1)
+            self.assertTrue(relay.state.may_inject_fds())
+            relay.inputs[client].data.extend(b'partial')
+            self.assertFalse(relay.state.may_inject_fds())
+            relay.inputs[client].data.clear()
+            relay.inputs[client].received_fd_count = 2
+            self.assertFalse(relay.state.may_inject_fds())
+            relay.state.client(bind(2, 41, 'zwp_linux_dmabuf_v1', 5))
+            relay.state.client(message(5, 1, words(6)))
+            relay.state.client(message(6, 1, words(0, 0, 0, 0, 0)))
+            self.assertEqual(relay.state.expected_client_fds, 2)
+            self.assertTrue(relay.state.may_inject_fds())
+        finally:
+            client.close()
+            peer.close()
+            relay.server.close()
+            relay.selector.close()
