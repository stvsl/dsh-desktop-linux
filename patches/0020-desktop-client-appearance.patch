+import { EventEmitter } from 'node:events'
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+import type { BrowserWindowConstructorOptions, MessageBoxOptions } from 'electron'
+import { afterEach, expect, it, onTestFinished, vi } from 'vitest'
+import * as appearance from '../src/client-appearance.ts'
+import { DEFAULT_CLIENT_APPEARANCE } from '../src/client-appearance.ts'
+import { ClientSettingsWindow } from '../src/client-settings.ts'
+import { CLIENT_SETTINGS_IPC, type ClientSettingsReply, type ClientSettingsSnapshot } from '../src/client-settings-ipc.ts'
+
+const native = vi.hoisted(() => ({
+  handlers: new Map<string, (...args: unknown[]) => unknown>(),
+  create: vi.fn<(options: BrowserWindowConstructorOptions) => ReturnType<typeof fakeWindow>>(),
+  load: vi.fn<() => Promise<void>>(),
+  dialog: vi.fn<(_window: object, options: MessageBoxOptions) => Promise<{ response: number }>>(),
+  workArea: { x: 100, y: 20, width: 1200, height: 900 },
+  requestPermissions: vi.fn(), checkPermissions: vi.fn(),
+}))
+vi.mock('electron', () => ({
+  BrowserWindow: function (options: BrowserWindowConstructorOptions) { return native.create(options) },
+  ipcMain: {
+    handle(channel: string, handler: (...args: unknown[]) => unknown) {
+      if (native.handlers.has(channel)) throw new Error('handler already registered')
+      native.handlers.set(channel, handler)
+    },
+    removeHandler(channel: string) { native.handlers.delete(channel) },
+  },
+  dialog: { showMessageBox: native.dialog },
+  screen: { getCursorScreenPoint: () => ({ x: 1, y: 1 }), getDisplayNearestPoint: () => ({ workArea: native.workArea }) },
+  session: { fromPartition: () => ({ setPermissionRequestHandler: native.requestPermissions, setPermissionCheckHandler: native.checkPermissions }) },
+}))
+vi.mock('../src/client-appearance.ts', async original => ({ ...await original<typeof import('../src/client-appearance.ts')>() }))
+
+const rendererPath = fileURLToPath(new URL('../renderer/client-settings.html', import.meta.url))
+let manager: ClientSettingsWindow | undefined
+
+function fakeWindow() {
+  let destroyed = false
+  let url = ''
+  const contents = Object.assign(new EventEmitter(), {
+    mainFrame: { url: '' }, getURL: () => url, setWindowOpenHandler: vi.fn(),
+  })
+  const window = Object.assign(new EventEmitter(), {
+    webContents: contents,
+    setMenu: vi.fn(), isDestroyed: () => destroyed, isMinimized: vi.fn(() => false),
+    show: vi.fn(), focus: vi.fn(), restore: vi.fn(),
+    destroy: vi.fn(() => { destroyed = true; window.emit('closed') }),
+    loadFile: vi.fn(async (path: string) => {
+      await native.load()
+      contents.mainFrame.url = pathToFileURL(path).href
+      url = contents.mainFrame.url
+    }),
+    changeUrl(next: string) { contents.mainFrame.url = next; url = next },
+  })
+  return window
+}
+
+afterEach(() => {
+  manager?.dispose()
+  manager = undefined
+  native.handlers.clear()
+  vi.restoreAllMocks()
+  vi.resetAllMocks()
+  native.workArea = { x: 100, y: 20, width: 1200, height: 900 }
+})
+
+async function fixture(locale = 'zh-CN') {
+  const root = await mkdtemp(join(tmpdir(), 'client-settings-window-'))
+  onTestFinished(() => rm(root, { recursive: true, force: true }))
+  await appearance.saveClientAppearance(root, DEFAULT_CLIENT_APPEARANCE)
+  const windows: ReturnType<typeof fakeWindow>[] = []
+  native.create.mockImplementation(() => { const window = fakeWindow(); windows.push(window); return window })
+  native.load.mockResolvedValue()
+  native.dialog.mockResolvedValue({ response: 0 })
+  const restart = vi.fn<() => Promise<void>>().mockResolvedValue()
+  manager = new ClientSettingsWindow({ userData: root, rendererPath, preloadPath: join(root, 'preload.cjs'),
+    locale: () => locale, current: DEFAULT_CLIENT_APPEARANCE, restart })
+  function event() {
+    const window = windows.at(-1)!
+    return { sender: window.webContents, senderFrame: window.webContents.mainFrame }
+  }
+  const invoke = <T>(channel: string, ...args: unknown[]) => Promise.resolve(native.handlers.get(channel)!(event(), ...args)) as Promise<ClientSettingsReply<T>>
+  return { root, windows, restart, event, invoke,
+    get: () => invoke<ClientSettingsSnapshot>(CLIENT_SETTINGS_IPC.get),
+    save: (value: unknown) => invoke<ClientSettingsSnapshot>(CLIENT_SETTINGS_IPC.save, value),
+    restartNow: () => invoke<{ restarted: boolean }>(CLIENT_SETTINGS_IPC.restart),
+  }
+}
+
+it('creates an independent native, opaque, sandboxed window and reuses it on repeated open', async () => {
+  const f = await fixture()
+  await manager!.open()
+  await manager!.open()
+  expect(native.create).toHaveBeenCalledOnce()
+  expect(native.create.mock.calls[0]![0]).toMatchObject({
+    frame: true, transparent: false, hasShadow: true, width: 660, height: 760, minWidth: 600,
+    maxWidth: 1200, maxHeight: 900,
+    webPreferences: { contextIsolation: true, sandbox: true, nodeIntegration: false, webSecurity: true, webviewTag: false },
+  })
+  const window = f.windows[0]!
+  expect(window.loadFile).toHaveBeenCalledExactlyOnceWith(rendererPath)
+  expect(window.setMenu).toHaveBeenCalledWith(null)
+  expect(window.show).toHaveBeenCalledTimes(2)
+  expect(window.focus).toHaveBeenCalledTimes(2)
+  window.isMinimized.mockReturnValue(true)
+  await manager!.open()
+  expect(window.restore).toHaveBeenCalledOnce()
+  const view = await f.get()
+  expect(view).toMatchObject({ kind: 'ok', locale: 'zh-CN', value: { current: DEFAULT_CLIENT_APPEARANCE,
+    saved: DEFAULT_CLIENT_APPEARANCE, restartRequired: false } })
+  expect(view.messages.restartDetail).toContain('主机任务会被中断')
+})
+
+it('bounds dimensions to a small current work area without forcing a window outside it', async () => {
+  native.workArea = { x: -200, y: -40, width: 560, height: 420 }
+  await fixture('en')
+  await manager!.open()
+  expect(native.create.mock.calls[0]![0]).toMatchObject({ width: 560, minWidth: 560, height: 420, minHeight: 420,
+    maxWidth: 560, maxHeight: 420, x: -200, y: -40 })
+})
+
+it('shares a pending load and does not create a second window while opening', async () => {
+  const f = await fixture()
+  const loading = Promise.withResolvers<void>()
+  native.load.mockReturnValueOnce(loading.promise)
+  const first = manager!.open()
+  const second = manager!.open()
+  onTestFinished(async () => { loading.resolve(); await Promise.allSettled([first, second]) })
+  await vi.waitFor(() => { expect(native.create).toHaveBeenCalledOnce() })
+  expect(f.windows[0]!.show).not.toHaveBeenCalled()
+  loading.resolve()
+  await Promise.all([first, second])
+  expect(native.create).toHaveBeenCalledOnce()
+})
+
+it('refuses every navigation, webview, popup and permission without touching another session', async () => {
+  const f = await fixture()
+  await manager!.open()
+  const window = f.windows[0]!
+  for (const event of ['will-navigate', 'will-frame-navigate', 'will-redirect', 'will-attach-webview']) {
+    const preventDefault = vi.fn()
+    window.webContents.emit(event, { preventDefault }, 'https://untrusted.example/')
+    expect(preventDefault).toHaveBeenCalledOnce()
+  }
+  expect(window.webContents.setWindowOpenHandler.mock.calls[0]![0]()).toEqual({ action: 'deny' })
+  const respond = vi.fn()
+  native.requestPermissions.mock.calls[0]![0](window.webContents, 'media', respond)
+  expect(respond).toHaveBeenCalledExactlyOnceWith(false)
+  expect(native.checkPermissions.mock.calls[0]![0]()).toBe(false)
+})
+
+it('rejects foreign senders, child frames and file URLs with query, fragment or another path', async () => {
+  const f = await fixture()
+  await manager!.open()
+  const handler = native.handlers.get(CLIENT_SETTINGS_IPC.get)!
+  const event = f.event()
+  for (const invalid of [{ ...event, sender: {} }, { ...event, senderFrame: { ...event.senderFrame } }, { ...event, senderFrame: null }]) {
+    await expect(handler(invalid)).rejects.toMatchObject({ kind: 'sender' })
+  }
+  const window = f.windows[0]!
+  for (const suffix of ['?other=1', '#other', '/other.html']) {
+    window.changeUrl(pathToFileURL(rendererPath).href + suffix)
+    await expect(handler(f.event())).rejects.toMatchObject({ kind: 'sender' })
+  }
+  window.changeUrl(pathToFileURL(rendererPath).href)
+  await expect(handler(f.event(), 'unexpected')).rejects.toMatchObject({ kind: 'arguments' })
+})
+
+it('saves the next-launch value without mutating the immutable run snapshot or returning unrelated settings', async () => {
+  const f = await fixture('en-US')
+  await manager!.open()
+  const next = { ...DEFAULT_CLIENT_APPEARANCE, cornerRadius: 0, sidebarOpacity: 100 }
+  const result = await f.save(next)
+  expect(result).toMatchObject({ kind: 'ok', locale: 'en', value: { current: DEFAULT_CLIENT_APPEARANCE, saved: next, restartRequired: true } })
+  expect(await appearance.readClientAppearance(f.root, {})).toEqual(next)
+  expect((await f.get())).toMatchObject({ kind: 'ok', value: { current: DEFAULT_CLIENT_APPEARANCE, saved: next } })
+  expect(JSON.stringify(result)).not.toMatch(/DEEPSEEK_API_KEY|process\.env|userData|preloadPath/u)
+  expect(f.restart).not.toHaveBeenCalled()
+})
