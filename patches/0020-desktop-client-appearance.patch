diff --git a/apps/desktop/src/wayland-bootstrap.ts b/apps/desktop/src/wayland-bootstrap.ts
new file mode 100644
index 00000000..68d27a04
--- /dev/null
+++ b/apps/desktop/src/wayland-bootstrap.ts
@@ -0,0 +1,44 @@
+/** Launch the native Wayland relay before creating any windows; restart through its owned supervisor. */
+import { spawn } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { app } from 'electron'
+import { waylandClient } from './wayland-csd.ts'
+import { LINUX_PRIMARY_WINDOW_TITLE } from './linux-chrome-ipc.ts'
+import type { ClientAppearance } from './client-appearance.ts'
+
+/** Paths supplied by the development or packaged resource resolver. */
+export interface WaylandProxyPaths { readonly python: string; readonly proxy: string }
+
+/** @param value - Launch-time appearance snapshot. @param paths - Bundled Python and relay. @returns Whether a relay now owns the next application process. */
+export async function launchWaylandProxy(value: ClientAppearance, paths: WaylandProxyPaths): Promise<boolean> {
+  if (process.platform !== 'linux' || !(value.frameless || (value.sidebarGlass && value.waylandBlur)) || !waylandClient(process.argv, process.env)
+    || process.env.DSH_WAYLAND_PROXY_ACTIVE === '1') return false
+  for (const path of [paths.python, paths.proxy]) if (!existsSync(path)) throw new Error(`desktop Wayland: missing bundled resource: ${path}`)
+  const env = { ...process.env }
+  delete env.ELECTRON_RUN_AS_NODE
+  const args = [paths.proxy, '--surface-title', LINUX_PRIMARY_WINDOW_TITLE, '--corner-radius', String(value.frameless ? value.cornerRadius : 0), value.frameless && value.systemShadow ? '--shadow' : '--no-shadow',
+    ...value.sidebarGlass && value.waylandBlur ? [] : ['--no-blur'], '--', process.execPath, ...process.argv.slice(1)]
+  // The successor must claim the same profile, not race a still-held bootstrap lock.
+  app.releaseSingleInstanceLock()
+  const child = spawn(paths.python, args, { env, detached: true, stdio: 'inherit' })
+  await new Promise<void>((resolve, reject) => { child.once('error', reject); child.once('spawn', resolve) })
+  console.info(`desktop Wayland: supervisor_pid=${child.pid}`)
+  child.unref()
+  return true
+}
+
+/** @param value - Saved preferences. Requests restart only after the application's normal backend teardown. */
+export async function prepareAppearanceRestart(value: ClientAppearance): Promise<void> {
+  const path = process.env.DSH_WAYLAND_PROXY_RESTART_FILE
+  if (process.env.DSH_WAYLAND_PROXY_ACTIVE === '1' && path !== undefined) {
+    await writeFile(path, JSON.stringify({ cornerRadius: value.frameless ? value.cornerRadius : 0,
+      systemShadow: value.frameless && value.systemShadow, waylandBlur: value.sidebarGlass && value.waylandBlur }), { mode: 0o600 })
+  } else {
+    app.relaunch()
+  }
+}
+
+/** @param primaryRuntime - Bundled runtime root. @returns Python interpreter inside the runtime. */
+export function waylandProxyPython(primaryRuntime: string): string { return join(primaryRuntime, 'dependencies', 'python', 'bin', 'python3') }
diff --git a/apps/desktop/tests/client-appearance.spec.ts b/apps/desktop/tests/client-appearance.spec.ts
new file mode 100644
index 00000000..4cec4743
--- /dev/null
+++ b/apps/desktop/tests/client-appearance.spec.ts
@@ -0,0 +1,152 @@
+import { mkdtemp, mkdir, readFile, readdir, rm, stat, writeFile } from 'node:fs/promises'
+import * as fs from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { afterEach, describe, expect, it, onTestFinished, vi } from 'vitest'
+import {
+  ClientAppearanceError, DEFAULT_CLIENT_APPEARANCE, parseClientAppearance, readClientAppearance, saveClientAppearance,
+} from '../src/client-appearance.ts'
+
+vi.mock('node:fs/promises', async original => ({ ...await original<typeof import('node:fs/promises')>() }))
+afterEach(() => { vi.restoreAllMocks() })
+
+async function fixture(raw?: string) {
+  const root = await mkdtemp(join(tmpdir(), 'client-appearance-'))
+  onTestFinished(() => rm(root, { recursive: true, force: true }))
+  const path = join(root, 'desktop', 'appearance.json')
+  if (raw !== undefined) { await mkdir(dirname(path)); await writeFile(path, raw) }
+  return { root, path }
+}
+
+describe('client appearance validation', () => {
+  it('returns an immutable detached six-field value and accepts both integer endpoints', () => {
+    const input = { ...DEFAULT_CLIENT_APPEARANCE }
+    const value = parseClientAppearance(input)
+    input.cornerRadius = 4
+    expect(value).toEqual(DEFAULT_CLIENT_APPEARANCE)
+    expect(value).not.toBe(input)
+    expect(Object.isFrozen(value)).toBe(true)
+    for (const cornerRadius of [0, 32]) for (const sidebarOpacity of [0, 100]) {
+      expect(parseClientAppearance({ ...value, cornerRadius, sidebarOpacity })).toMatchObject({ cornerRadius, sidebarOpacity })
+    }
+  })
+
+  it.each([undefined, null, true, [], {}, 'appearance', { ...DEFAULT_CLIENT_APPEARANCE, unknown: true },
+    { ...DEFAULT_CLIENT_APPEARANCE, schemaVersion: 1 }, Object.create(DEFAULT_CLIENT_APPEARANCE)])(
+    'rejects missing, inherited and unknown fields without coercion: %s', value => {
+      expect(() => parseClientAppearance(value)).toThrow(ClientAppearanceError)
+    },
+  )
+
+  it.each(['frameless', 'systemShadow', 'sidebarGlass', 'waylandBlur'] as const)('strictly validates boolean %s', field => {
+    for (const value of [undefined, null, 0, 1, 'true', 'false', [], {}]) {
+      expect(() => parseClientAppearance({ ...DEFAULT_CLIENT_APPEARANCE, [field]: value })).toThrow(ClientAppearanceError)
+    }
+  })
+
+  it.each(['cornerRadius', 'sidebarOpacity'] as const)('rejects non-integer or out-of-range %s', field => {
+    for (const value of [-1, 101, 0.1, NaN, Infinity, '12', null, false]) {
+      expect(() => parseClientAppearance({ ...DEFAULT_CLIENT_APPEARANCE, [field]: value })).toThrow(ClientAppearanceError)
+    }
+    expect(() => parseClientAppearance({ ...DEFAULT_CLIENT_APPEARANCE, cornerRadius: 33 })).toThrow(ClientAppearanceError)
+  })
+})
+
+describe('client appearance file', () => {
+  it('reads macOS-like defaults without creating a file and preserves the supplied environment', async () => {
+    const { root, path } = await fixture()
+    const env = { UNRELATED: 'untouched' }
+    expect(await readClientAppearance(root, env)).toEqual(DEFAULT_CLIENT_APPEARANCE)
+    expect(env).toEqual({ UNRELATED: 'untouched' })
+    await expect(readFile(path)).rejects.toMatchObject({ code: 'ENOENT' })
+  })
+
+  it('uses legacy values only before the first save, with file values winning on subsequent reads', async () => {
+    const { root } = await fixture()
+    const env = { DSH_DESKTOP_FRAMELESS: '0', DSH_DESKTOP_GLASS: '0', DSH_DESKTOP_GLASS_TINT: '75' }
+    const current = await readClientAppearance(root, env)
+    expect(current).toEqual({ ...DEFAULT_CLIENT_APPEARANCE, frameless: false, sidebarGlass: false, sidebarOpacity: 75 })
+    const saved = await saveClientAppearance(root, { ...DEFAULT_CLIENT_APPEARANCE, cornerRadius: 0, sidebarOpacity: 20 })
+    expect(await readClientAppearance(root, env)).toEqual(saved)
+    expect(current).toEqual({ ...DEFAULT_CLIENT_APPEARANCE, frameless: false, sidebarGlass: false, sidebarOpacity: 75 })
+    expect(env).toEqual({ DSH_DESKTOP_FRAMELESS: '0', DSH_DESKTOP_GLASS: '0', DSH_DESKTOP_GLASS_TINT: '75' })
+  })
+
+  it.each(['', '-1', '101', '1.5', '50%', ' 50', '50\n', '1000', 'NaN'])('does not import invalid legacy tint %j', async tint => {
+    const { root } = await fixture()
+    expect((await readClientAppearance(root, { DSH_DESKTOP_GLASS_TINT: tint })).sidebarOpacity).toBe(50)
+  })
+
+  it.each(['0', '100', '001'])('accepts integer legacy tint %s', async tint => {
+    const { root } = await fixture()
+    expect((await readClientAppearance(root, { DSH_DESKTOP_GLASS_TINT: tint })).sidebarOpacity).toBe(Number(tint))
+  })
+
+  it('retains exact legacy boolean opt-in semantics for explicitly supplied values', async () => {
+    const { root } = await fixture()
+    for (const raw of ['1', 'true', '', '0']) {
+      const value = await readClientAppearance(root, { DSH_DESKTOP_FRAMELESS: raw, DSH_DESKTOP_GLASS: raw })
+      expect(value.frameless).toBe(raw === '1')
+      expect(value.sidebarGlass).toBe(raw === '1')
+    }
+  })
+
+  it('round-trips a versioned document using only appearance fields and never opens unrelated settings', async () => {
+    const { root, path } = await fixture()
+    const settings = join(root, 'desktop', 'settings.json')
+    await mkdir(dirname(settings))
+    await writeFile(settings, 'unrelated-file-must-stay-unread')
+    const read = vi.spyOn(fs, 'readFile')
+    const value = { ...DEFAULT_CLIENT_APPEARANCE, systemShadow: false, cornerRadius: 32, sidebarOpacity: 0 }
+    expect(await saveClientAppearance(root, value)).toEqual(value)
+    expect(await readClientAppearance(root, {})).toEqual(value)
+    expect(read.mock.calls.every(([file]) => file === path)).toBe(true)
+    expect(JSON.parse(await readFile(path, 'utf8'))).toEqual({ schemaVersion: 1, ...value })
+    expect(await readFile(settings, 'utf8')).toBe('unrelated-file-must-stay-unread')
+  })
+
+  it.skipIf(process.platform === 'win32')('replaces wider file permissions with owner-only mode', async () => {
+    const { root, path } = await fixture(JSON.stringify({ schemaVersion: 1, ...DEFAULT_CLIENT_APPEARANCE }))
+    await fs.chmod(path, 0o644)
+    await saveClientAppearance(root, DEFAULT_CLIENT_APPEARANCE)
+    expect((await stat(path)).mode & 0o777).toBe(0o600)
+  })
+
+  it.each([
+    ['{"private":"do-not-quote"', 'json'], ['null', 'document'], ['[]', 'document'],
+    [JSON.stringify({ ...DEFAULT_CLIENT_APPEARANCE }), 'version'],
+    [JSON.stringify({ schemaVersion: '1', ...DEFAULT_CLIENT_APPEARANCE }), 'version'],
+    [JSON.stringify({ schemaVersion: 2, ...DEFAULT_CLIENT_APPEARANCE }), 'version'],
+    [JSON.stringify({ schemaVersion: 1, ...DEFAULT_CLIENT_APPEARANCE, future: true }), 'document'],
+    [JSON.stringify({ schemaVersion: 1, ...DEFAULT_CLIENT_APPEARANCE, cornerRadius: 40 }), 'fields'],
+    [JSON.stringify({ schemaVersion: 1, ...DEFAULT_CLIENT_APPEARANCE, systemShadow: 'false' }), 'fields'],
+  ])('reports invalid persisted documents and never replaces them: %s', async (raw, kind) => {
+    const { root, path } = await fixture(raw)
+    await expect(readClientAppearance(root, {})).rejects.toMatchObject({ name: 'ClientAppearanceError', problem: { kind } })
+    await expect(saveClientAppearance(root, DEFAULT_CLIENT_APPEARANCE)).rejects.toMatchObject({ problem: { kind } })
+    expect(await readFile(path, 'utf8')).toBe(raw)
+    try { await readClientAppearance(root, {}) } catch (error) { expect(String(error)).not.toContain('do-not-quote') }
+  })
+
+  it('rejects invalid IPC input before creating directories or replacing a file', async () => {
+    const { root } = await fixture()
+    await expect(saveClientAppearance(root, { ...DEFAULT_CLIENT_APPEARANCE, sidebarOpacity: 0.5 })).rejects.toMatchObject({ problem: { kind: 'fields' } })
+    expect(await readdir(root)).toEqual([])
+  })
+
+  it('reports unreadable files instead of silently selecting defaults', async () => {
+    const { root, path } = await fixture()
+    await mkdir(path, { recursive: true })
+    await expect(readClientAppearance(root, {})).rejects.toMatchObject({ problem: { kind: 'read' } })
+    expect((await stat(path)).isDirectory()).toBe(true)
+  })
+
+  it.each(['mkdir', 'writeFile', 'rename'] as const)('preserves the original bytes and removes temporary files after %s failure', async operation => {
+    const raw = JSON.stringify({ schemaVersion: 1, ...DEFAULT_CLIENT_APPEARANCE })
+    const { root, path } = await fixture(raw)
+    vi.spyOn(fs, operation).mockRejectedValueOnce(Object.assign(new Error('injected filesystem failure'), { code: 'EIO' }))
+    await expect(saveClientAppearance(root, { ...DEFAULT_CLIENT_APPEARANCE, cornerRadius: 3 })).rejects.toMatchObject({ problem: { kind: 'write' } })
+    expect(await readFile(path, 'utf8')).toBe(raw)
+    expect(await readdir(dirname(path))).toEqual(['appearance.json'])
+  })
+})
diff --git a/apps/desktop/tests/client-settings-preload.spec.ts b/apps/desktop/tests/client-settings-preload.spec.ts
