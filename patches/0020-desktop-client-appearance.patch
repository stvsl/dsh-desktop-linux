diff --git a/apps/desktop/src/client-appearance.ts b/apps/desktop/src/client-appearance.ts
new file mode 100644
index 00000000..739299c9
--- /dev/null
+++ b/apps/desktop/src/client-appearance.ts
@@ -0,0 +1,145 @@
+/** Strict, credential-free appearance preferences; persistence never changes the running window. */
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { writeFileAtomic } from '@deepseek-ai/dsh-atomic-write'
+
+/** Startup-only native-window and sidebar preferences. Opacity is fill, not transparency. */
+export interface ClientAppearance {
+  readonly frameless: boolean
+  readonly cornerRadius: number
+  readonly systemShadow: boolean
+  readonly sidebarGlass: boolean
+  readonly sidebarOpacity: number
+  readonly waylandBlur: boolean
+}
+
+/** Initial macOS-like preferences before a saved document or legacy environment override exists. */
+export const DEFAULT_CLIENT_APPEARANCE: ClientAppearance = Object.freeze({
+  frameless: true,
+  cornerRadius: 12,
+  systemShadow: true,
+  sidebarGlass: true,
+  sidebarOpacity: 50,
+  waylandBlur: true,
+})
+
+/** Failure categories never contain file contents or unrecognized input values. */
+export type ClientAppearanceProblem =
+  | { readonly kind: 'json' | 'document' | 'version' | 'read' | 'write' }
+  | { readonly kind: 'fields'; readonly field?: keyof ClientAppearance }
+
+/** Validation and filesystem errors leave application policy to the startup or settings-window owner. */
+export class ClientAppearanceError extends Error {
+  /**
+   * @param problem - Handling-relevant validation or I/O category.
+   * @param options - Original filesystem failure, when available; JSON parser diagnostics are omitted.
+   */
+  constructor(readonly problem: ClientAppearanceProblem, options?: ErrorOptions) {
+    super(`Client appearance: ${problem.kind}`, options)
+    this.name = 'ClientAppearanceError'
+  }
+}
+
+const appearanceKeys = ['frameless', 'cornerRadius', 'systemShadow', 'sidebarGlass', 'sidebarOpacity', 'waylandBlur'] as const
+
+function record(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+function boolean(value: unknown, field: keyof ClientAppearance): boolean {
+  if (typeof value !== 'boolean') throw new ClientAppearanceError({ kind: 'fields', field })
+  return value
+}
+
+function integer(value: unknown, field: keyof ClientAppearance, maximum: number): number {
+  if (typeof value !== 'number' || !Number.isInteger(value) || value < 0 || value > maximum) {
+    throw new ClientAppearanceError({ kind: 'fields', field })
+  }
+  return value
+}
+
+/**
+ * Validate every appearance field without coercion; missing and unknown fields are rejected.
+ * @param value - Untrusted IPC payload containing exactly the six appearance fields, without schemaVersion.
+ * @returns A detached, immutable preference value; throws ClientAppearanceError on invalid input.
+ */
+export function parseClientAppearance(value: unknown): ClientAppearance {
+  if (!record(value) || Reflect.ownKeys(value).length !== appearanceKeys.length
+    || !appearanceKeys.every(key => Object.hasOwn(value, key))) {
+    throw new ClientAppearanceError({ kind: 'fields' })
+  }
+  return Object.freeze({
+    frameless: boolean(value.frameless, 'frameless'),
+    cornerRadius: integer(value.cornerRadius, 'cornerRadius', 32),
+    systemShadow: boolean(value.systemShadow, 'systemShadow'),
+    sidebarGlass: boolean(value.sidebarGlass, 'sidebarGlass'),
+    sidebarOpacity: integer(value.sidebarOpacity, 'sidebarOpacity', 100),
+    waylandBlur: boolean(value.waylandBlur, 'waylandBlur'),
+  })
+}
+
+function appearancePath(userData: string): string { return join(userData, 'desktop', 'appearance.json') }
+
+function parseDocument(value: unknown): ClientAppearance {
+  if (!record(value)) throw new ClientAppearanceError({ kind: 'document' })
+  if (value.schemaVersion !== 1) throw new ClientAppearanceError({ kind: 'version' })
+  if (Reflect.ownKeys(value).length !== appearanceKeys.length + 1) throw new ClientAppearanceError({ kind: 'document' })
+  const { schemaVersion: _version, ...appearance } = value
+  return parseClientAppearance(appearance)
+}
+
+async function readSavedAppearance(userData: string): Promise<ClientAppearance | undefined> {
+  let raw: string
+  try { raw = await readFile(appearancePath(userData), 'utf8') } catch (error) {
+    if (error !== null && typeof error === 'object' && 'code' in error && error.code === 'ENOENT') return undefined
+    throw new ClientAppearanceError({ kind: 'read' }, { cause: error })
+  }
+  let value: unknown
+  try { value = JSON.parse(raw) } catch (_error) {
+    // SyntaxError messages may quote document contents; only the failure category crosses IPC.
+    throw new ClientAppearanceError({ kind: 'json' })
+  }
+  return parseDocument(value)
+}
+
+function initialAppearance(env: NodeJS.ProcessEnv): ClientAppearance {
+  const tint = env.DSH_DESKTOP_GLASS_TINT
+  const opacity = tint !== undefined && /^\d{1,3}$/u.test(tint) && Number(tint) <= 100
+    ? Number(tint) : DEFAULT_CLIENT_APPEARANCE.sidebarOpacity
+  return parseClientAppearance({
+    ...DEFAULT_CLIENT_APPEARANCE,
+    frameless: env.DSH_DESKTOP_FRAMELESS === undefined ? DEFAULT_CLIENT_APPEARANCE.frameless : env.DSH_DESKTOP_FRAMELESS === '1',
+    sidebarGlass: env.DSH_DESKTOP_GLASS === undefined ? DEFAULT_CLIENT_APPEARANCE.sidebarGlass : env.DSH_DESKTOP_GLASS === '1',
+    sidebarOpacity: opacity,
+  })
+}
+
+/**
+ * Read a complete startup snapshot. An invalid saved document fails rather than falling back to environment values.
+ * @param userData - Electron app.getPath('userData'); only desktop/appearance.json is read.
+ * @param env - Legacy initial values when no file exists; omission reads process.env without modifying it.
+ * @returns Immutable saved preferences, or macOS-like defaults with legacy initial values on ENOENT.
+ */
+export async function readClientAppearance(userData: string, env: NodeJS.ProcessEnv = process.env): Promise<ClientAppearance> {
+  return await readSavedAppearance(userData) ?? initialAppearance(env)
+}
+
+/**
+ * Save the complete version-1 document. Failed preparation/write/rename preserves the previous file.
+ * Existing malformed or unsupported documents are not overwritten. Concurrent complete saves are last-writer-wins.
+ * @param userData - Electron userData; unrelated settings and credentials are never read or written.
+ * @param value - Untrusted six-field appearance value, validated before filesystem work.
+ * @returns The immutable saved value after atomic mode-0600 replacement; does not mutate a startup snapshot or env.
+ */
+export async function saveClientAppearance(userData: string, value: unknown): Promise<ClientAppearance> {
+  const appearance = parseClientAppearance(value)
+  await readSavedAppearance(userData)
+  try {
+    await writeFileAtomic(appearancePath(userData), `${JSON.stringify({ schemaVersion: 1, ...appearance }, null, 2)}\n`, {
+      mode: 0o600, dirMode: 0o700,
+    })
+  } catch (error) {
+    throw new ClientAppearanceError({ kind: 'write' }, { cause: error })
+  }
+  return appearance
+}
