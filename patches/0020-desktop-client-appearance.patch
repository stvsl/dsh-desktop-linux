+class FdInjectionTest(unittest.TestCase):
+    def test_split_header_fd_is_counted_once_across_receives_and_take(self):
+        import array
+        sender, receiver = socket.socketpair()
+        read_fd, write_fd = os.pipe()
+        from wayland_blur_proxy import Framer
+        stream = Framer()
+        try:
+            frame = message(3, 0, words(4, 9600))
+            sender.sendmsg([frame[:3]], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array('i', [read_fd]))])
+            self.assertTrue(stream.receive(receiver))
+            self.assertEqual(stream.received_fd_count, 1)
+            self.assertIsNone(stream.pop())
+            sender.sendall(frame[3:])
+            self.assertTrue(stream.receive(receiver))
+            self.assertEqual(stream.received_fd_count, 1)
+            self.assertEqual(stream.pop(), frame)
+            for fd in stream.take_fds():
+                os.close(fd)
+            self.assertEqual(stream.received_fd_count, 1)
+        finally:
+            for fd in stream.fds + [read_fd, write_fd]:
+                os.close(fd)
+            sender.close()
+            receiver.close()
+
+    def test_early_fd_blocks_memfd_until_known_consuming_request_and_batch_boundary(self):
+        client, peer = socket.socketpair()
