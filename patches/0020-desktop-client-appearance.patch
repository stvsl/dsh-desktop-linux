+  if (reason === 'close') { f.windows[0]!.destroy(); await manager!.open() } else manager!.dispose()
+  expect(dialog.signal!.aborted).toBe(true)
+  answer.resolve({ response: 1 })
+  expect(await pending).toMatchObject({ kind: 'ok', value: { restarted: false } })
+  expect(f.restart).not.toHaveBeenCalled()
+})
