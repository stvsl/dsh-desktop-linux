+  expect(await readFile(join(f.root, 'desktop', 'appearance.json'), 'utf8')).toBe('{"hidden":"never-quote-this"')
+})
+
+it('prevents duplicate saves and restart confirmations while the owned atomic save is pending', async () => {
+  const f = await fixture()
