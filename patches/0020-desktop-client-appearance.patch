+++ b/apps/desktop/src/client-settings-messages.ts
@@ -0,0 +1,44 @@
+/** Load the independent window's renderer-owned dictionaries without exposing arbitrary file access. */
+import { readFile } from 'node:fs/promises'
+import { dirname, join } from 'node:path'
+import { CLIENT_SETTINGS_MESSAGE_KEYS, type ClientSettingsMessages } from './client-settings-ipc.ts'
+
+/** Renderer-resource errors contain neither dictionary contents nor arbitrary file paths. */
+export class ClientSettingsResourcesError extends Error {
+  /** @param options - Original file or JSON-resource failure, when available. */
+  constructor(options?: ErrorOptions) {
+    super('Client settings resources could not be loaded', options)
+    this.name = 'ClientSettingsResourcesError'
+  }
+}
+
+/**
+ * @param rendererPath - Fixed client-settings.html path; dictionaries are loaded from its client-settings sibling directory.
+ * @param locale - A zh-prefixed locale selects Simplified Chinese; all other locales select English.
+ * @returns Validated localized copy, shared by the document and the native confirmation.
+ */
+export async function readClientSettingsMessages(rendererPath: string, locale: string): Promise<{
+  readonly locale: 'zh-CN' | 'en'
+  readonly messages: ClientSettingsMessages
+}> {
+  let dictionaries: unknown
+  try {
+    dictionaries = JSON.parse(await readFile(join(dirname(rendererPath), 'client-settings', 'messages.json'), 'utf8'))
+  } catch (error) {
+    throw new ClientSettingsResourcesError({ cause: error })
+  }
+  const chinese = /^zh(?:[-_]|$)/iu.test(locale) || locale === 'zhCN'
+  const language = chinese ? 'zhCN' : 'en'
+  if (dictionaries === null || typeof dictionaries !== 'object' || !(language in dictionaries)) throw new ClientSettingsResourcesError()
+  const value: unknown = dictionaries[language as keyof typeof dictionaries]
+  if (value === null || typeof value !== 'object' || Array.isArray(value)
+    || Object.keys(value).length !== CLIENT_SETTINGS_MESSAGE_KEYS.length) throw new ClientSettingsResourcesError()
+  const messages: Partial<Record<typeof CLIENT_SETTINGS_MESSAGE_KEYS[number], string>> = {}
+  for (const key of CLIENT_SETTINGS_MESSAGE_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ClientSettingsResourcesError()
+    const text: unknown = value[key as keyof typeof value]
+    if (typeof text !== 'string' || text.length === 0) throw new ClientSettingsResourcesError()
+    messages[key] = text
+  }
+  return { locale: chinese ? 'zh-CN' : 'en', messages: Object.freeze(messages) as ClientSettingsMessages }
+}
diff --git a/apps/desktop/src/client-settings.ts b/apps/desktop/src/client-settings.ts
new file mode 100644
index 00000000..0ca32315
--- /dev/null
+++ b/apps/desktop/src/client-settings.ts
@@ -0,0 +1,226 @@
+/** Independent, opaque settings window; only its exact local main frame can use the appearance IPC. */
+import { randomUUID } from 'node:crypto'
+import { resolve } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { BrowserWindow, dialog, ipcMain, screen, session, type IpcMainInvokeEvent, type Session } from 'electron'
+import {
+  ClientAppearanceError, DEFAULT_CLIENT_APPEARANCE, parseClientAppearance, readClientAppearance, saveClientAppearance,
+  type ClientAppearance,
+} from './client-appearance.ts'
+import {
+  CLIENT_SETTINGS_IPC, type ClientSettingsMessages, type ClientSettingsProblem, type ClientSettingsReply, type ClientSettingsSnapshot,
+} from './client-settings-ipc.ts'
+import { readClientSettingsMessages } from './client-settings-messages.ts'
+
+/** Deployment paths and startup appearance are main-owned; the renderer cannot supply them. */
+export interface ClientSettingsWindowOptions {
+  readonly userData: string
+  readonly preloadPath: string
+  readonly rendererPath: string
+  readonly locale: () => string
+  readonly current: ClientAppearance
+  /** Relaunch through the existing Host shutdown path; invoked only after a native confirmation. */
+  readonly restart: () => Promise<void> | void
+}
+
+/** Lifecycle and authorization failures are separate from file validation failures. */
+export class ClientSettingsWindowError extends Error {
+  /** @param kind - A closed manager or an unowned/invalid IPC request. */
+  constructor(readonly kind: 'closed' | 'sender' | 'arguments') {
+    super(`Client settings: ${kind}`)
+    this.name = 'ClientSettingsWindowError'
+  }
+}
+
+function differs(left: ClientAppearance, right: ClientAppearance): boolean {
+  return left.frameless !== right.frameless || left.cornerRadius !== right.cornerRadius || left.systemShadow !== right.systemShadow
+    || left.sidebarGlass !== right.sidebarGlass || left.sidebarOpacity !== right.sidebarOpacity || left.waylandBlur !== right.waylandBlur
+}
+
+/** One reusable native window per manager; disposal never quits or destroys another application window. */
+export class ClientSettingsWindow {
+  private readonly current: ClientAppearance
+  private readonly initialEnvironment: NodeJS.ProcessEnv
+  private readonly rendererPath: string
+  private readonly rendererUrl: string
+  private readonly handlers: string[] = []
+  private window: BrowserWindow | undefined
+  private ownedSession: Session | undefined
+  private opening: Promise<void> | undefined
+  private disposed = false
+  private pending: 'save' | 'restart' | undefined
+  private confirmation: AbortController | undefined
+  private copy: { readonly locale: 'zh-CN' | 'en'; readonly messages: ClientSettingsMessages } | undefined
+
+  /** @param options - Fixed local paths, immutable startup snapshot, locale reader and confirmed restart action. */
+  constructor(private readonly options: ClientSettingsWindowOptions) {
+    this.current = parseClientAppearance(options.current)
+    this.rendererPath = resolve(options.rendererPath)
+    this.rendererUrl = pathToFileURL(this.rendererPath).href
+    this.initialEnvironment = {
+      DSH_DESKTOP_FRAMELESS: process.env.DSH_DESKTOP_FRAMELESS,
+      DSH_DESKTOP_GLASS: process.env.DSH_DESKTOP_GLASS,
+      DSH_DESKTOP_GLASS_TINT: process.env.DSH_DESKTOP_GLASS_TINT,
+    }
+    try {
+      this.register(CLIENT_SETTINGS_IPC.get, async (event, ...args) => {
+        this.assertSender(event)
+        this.assertArguments(args, 0)
+        try { return this.ok(await this.snapshot()) } catch (error) { return this.failure(error) }
+      })
+      this.register(CLIENT_SETTINGS_IPC.save, async (event, ...args) => {
+        this.assertSender(event)
+        this.assertArguments(args, 1)
+        if (this.pending !== undefined) return this.error({ kind: 'busy' })
+        this.pending = 'save'
+        try {
+          const saved = await saveClientAppearance(this.options.userData, args[0])
+          return this.ok(this.snapshotOf(saved))
+        } catch (error) { return this.failure(error) } finally { this.pending = undefined }
+      })
+      this.register(CLIENT_SETTINGS_IPC.restart, async (event, ...args) => {
+        const owner = this.assertSender(event)
+        this.assertArguments(args, 0)
+        if (this.pending !== undefined) return this.error({ kind: 'busy' })
+        this.pending = 'restart'
+        const confirmation = new AbortController()
+        this.confirmation = confirmation
+        try {
+          const { messages } = this.requireCopy()
+          const answer = await dialog.showMessageBox(owner, {
+            type: 'warning', title: messages.restartTitle, message: messages.restartMessage, detail: messages.restartDetail,
+            buttons: [messages.cancel, messages.restartConfirm], defaultId: 0, cancelId: 0, noLink: true,
+            signal: confirmation.signal,
+          })
+          if (answer.response !== 1 || confirmation.signal.aborted || this.disposed || this.window !== owner || owner.isDestroyed()) {
+            return this.ok({ restarted: false })
+          }
+          await this.options.restart()
+          return this.ok({ restarted: true })
+        } catch (_error) {
+          return this.error({ kind: 'restart' })
+        } finally {
+          if (this.confirmation === confirmation) this.confirmation = undefined
+          this.pending = undefined
+        }
+      })
+    } catch (error) {
+      for (const channel of this.handlers) ipcMain.removeHandler(channel)
+      throw error
+    }
+  }
+
+  /**
+   * Create and load the fixed local page, or restore and focus this manager's existing window.
+   * @returns After loading and focus; rejects on resource/load failure or disposal without affecting the main window.
+   */
+  async open(): Promise<void> {
+    if (this.disposed) throw new ClientSettingsWindowError('closed')
+    if (this.opening !== undefined) await this.opening
+    else if (this.window === undefined || this.window.isDestroyed()) {
+      this.opening = this.create()
+      try { await this.opening } finally { this.opening = undefined }
+    }
+    const window = this.window
+    if (this.disposed || window === undefined || window.isDestroyed()) throw new ClientSettingsWindowError('closed')
+    if (window.isMinimized()) window.restore()
+    window.show()
+    window.focus()
+  }
+
+  /** Remove this manager's handlers, cancel its confirmation and destroy only its settings window. */
+  dispose(): void {
+    if (this.disposed) return
+    this.disposed = true
+    for (const channel of this.handlers) ipcMain.removeHandler(channel)
+    this.confirmation?.abort()
+    this.confirmation = undefined
+    const window = this.window
+    this.window = undefined
+    if (window !== undefined && !window.isDestroyed()) window.destroy()
+    this.ownedSession?.setPermissionRequestHandler(null)
+    this.ownedSession?.setPermissionCheckHandler(null)
+    this.ownedSession = undefined
+  }
+
+  private register(channel: string, handler: (event: IpcMainInvokeEvent, ...args: unknown[]) => unknown): void {
+    ipcMain.handle(channel, handler)
+    this.handlers.push(channel)
+  }
+
+  private assertArguments(args: readonly unknown[], length: number): void {
+    if (args.length !== length) throw new ClientSettingsWindowError('arguments')
+  }
+
+  private assertSender(event: IpcMainInvokeEvent): BrowserWindow {
+    const window = this.window
+    if (this.disposed || window === undefined || window.isDestroyed()) throw new ClientSettingsWindowError('sender')
+    const contents = window.webContents
+    if (event.sender !== contents || event.senderFrame !== contents.mainFrame
+      || event.senderFrame.url !== this.rendererUrl || contents.getURL() !== this.rendererUrl) {
+      throw new ClientSettingsWindowError('sender')
+    }
+    return window
+  }
+
+  private requireCopy(): { readonly locale: 'zh-CN' | 'en'; readonly messages: ClientSettingsMessages } {
+    if (this.copy === undefined) throw new ClientSettingsWindowError('closed')
+    return this.copy
+  }
+
+  private ok<T>(value: T): ClientSettingsReply<T> { return { ...this.requireCopy(), kind: 'ok', value } }
+  private error(problem: ClientSettingsProblem): ClientSettingsReply<never> { return { ...this.requireCopy(), kind: 'error', problem } }
+  private failure(error: unknown): ClientSettingsReply<never> {
+    return this.error(error instanceof ClientAppearanceError ? error.problem : { kind: 'unexpected' })
+  }
+
+  private snapshotOf(saved: ClientAppearance): ClientSettingsSnapshot {
+    return { current: this.current, saved, defaults: DEFAULT_CLIENT_APPEARANCE, restartRequired: differs(this.current, saved) }
+  }
+
+  private async snapshot(): Promise<ClientSettingsSnapshot> {
+    return this.snapshotOf(await readClientAppearance(this.options.userData, this.initialEnvironment))
+  }
+
+  private async create(): Promise<void> {
+    this.copy = await readClientSettingsMessages(this.rendererPath, this.options.locale())
+    if (this.disposed) throw new ClientSettingsWindowError('closed')
+    const workArea = screen.getDisplayNearestPoint(screen.getCursorScreenPoint()).workArea
+    const width = Math.min(660, workArea.width)
+    const height = Math.min(760, workArea.height)
+    const ownedSession = this.ownedSession ?? session.fromPartition(`dsh-client-settings-${randomUUID()}`)
+    this.ownedSession = ownedSession
+    ownedSession.setPermissionRequestHandler((_contents, _permission, respond) => { respond(false) })
+    ownedSession.setPermissionCheckHandler(() => false)
+    const window = new BrowserWindow({
+      title: this.copy.messages.title,
+      width, height, minWidth: Math.min(600, width), minHeight: Math.min(480, height),
+      maxWidth: workArea.width, maxHeight: workArea.height,
+      x: workArea.x + Math.floor((workArea.width - width) / 2),
+      y: workArea.y + Math.floor((workArea.height - height) / 2),
+      frame: true, transparent: false, hasShadow: true, backgroundColor: '#f5f5f7',
+      show: false, autoHideMenuBar: true,
+      webPreferences: {
+        preload: resolve(this.options.preloadPath), session: ownedSession,
+        sandbox: true, contextIsolation: true, nodeIntegration: false, webSecurity: true, webviewTag: false,
+      },
+    })
+    this.window = window
+    window.setMenu(null)
+    window.on('closed', () => {
+      if (this.window !== window) return
+      this.window = undefined
+      this.confirmation?.abort()
+    })
+    window.webContents.setWindowOpenHandler(() => ({ action: 'deny' }))
+    window.webContents.on('will-navigate', event => { event.preventDefault() })
+    window.webContents.on('will-frame-navigate', event => { event.preventDefault() })
+    window.webContents.on('will-redirect', event => { event.preventDefault() })
+    window.webContents.on('will-attach-webview', event => { event.preventDefault() })
+    try { await window.loadFile(this.rendererPath) } catch (error) {
+      if (this.window === window) this.window = undefined
+      if (!window.isDestroyed()) window.destroy()
+      throw error
+    }
+  }
+}
