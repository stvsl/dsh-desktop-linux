+        self.state.client(message(8, 2, words(17, 16)))
+        self.state.client(message(17, 1, words(18)))
+        self.assertTrue(self.delete_callback(19))
+        self.assertNotIn(16, self.state.effects)
+
+    def test_additional_toplevel_has_its_own_single_effect(self):
+        self.negotiate()
+        self.state.server(message(1, 1, words(6)))  # temporary region released
+        self.state.client(message(3, 0, words(16)))
+        self.state.client(message(8, 2, words(17, 16)))
+        self.state.client(message(17, 1, words(18)))
+        self.assertFalse(self.delete_callback(19))
+        self.assertEqual(len(self.state.owned), 5)
+        self.assertEqual(len(self.state.effects), 2)
+        self.assertNotEqual(self.state.effects[10], self.state.effects[16])
+        self.assertTrue(self.delete_callback(20))
+
+
+class TransportTest(unittest.TestCase):
+    def test_framing_and_fd_fifo_survive_split_messages(self):
+        sender, receiver = socket.socketpair()
+        read_fd, write_fd = os.pipe()
+        received = []
+        try:
+            frames = message(1, 0, words(2)) + message(1, 1, words(3))
+            sender.sendmsg([frames[:3]], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array('i', [read_fd]))])
+            stream = Framer()
+            self.assertTrue(stream.receive(receiver))
+            self.assertIsNone(stream.pop())
+            sender.sendall(frames[3:])
+            self.assertTrue(stream.receive(receiver))
+            self.assertEqual(stream.pop(), frames[:12])
+            received = stream.take_fds()
+            self.assertEqual(len(received), 1)
+            os.write(write_fd, b'fd is valid')
+            self.assertEqual(os.read(received[0], 11), b'fd is valid')
+            self.assertFalse(os.get_inheritable(received[0]))
+            self.assertEqual(stream.pop(), frames[12:])
+            self.assertIsNone(stream.pop())
+        finally:
+            for fd in received + [read_fd, write_fd]:
+                os.close(fd)
+            sender.close()
+            receiver.close()
+
+    def test_invalid_frame_rejected(self):
+        for size in (0, 4, 9):
+            stream = Framer()
+            stream.data.extend(struct.pack('=II', 1, size << 16))
+            with self.assertRaises(ValueError):
+                stream.pop()
+
+    def test_partial_writes_send_each_fd_only_once(self):
+        class PartialSender:
+            def __init__(self):
+                self.calls = []
+            def sendmsg(self, buffers, ancillary, flags):
+                self.calls.append(bool(ancillary))
+                return min(3, len(buffers[0]))
+        class Selector:
+            def modify(self, *args):
+                pass
+        sender = PartialSender()
+        read_fd, write_fd = os.pipe()
+        transfer_fd = os.dup(read_fd)
+        relay = object.__new__(Relay)
+        relay.selector = Selector()
+        relay.outputs = {sender: __import__('collections').deque()}
+        relay.queued_bytes = {sender: 0}
+        relay.log = lambda *_: None
+        try:
+            relay.queue(sender, message(1, 0, words(2)), [transfer_fd])
+            while relay.outputs[sender]:
+                relay.flush(sender)
+            self.assertEqual(sender.calls, [True, False, False, False])
+            self.assertEqual(relay.queued_bytes[sender], 0)
+            with self.assertRaises(OSError):
+                os.fstat(transfer_fd)
+        finally:
+            os.close(read_fd)
+            os.close(write_fd)
+
+    def test_sendmsg_closes_our_copy_and_preserves_received_fd(self):
+        sender, receiver = socket.socketpair()
+        read_fd, write_fd = os.pipe()
+        transferred_fd = os.dup(read_fd)
+        relay = Relay(sender, '/unused', threading.Event(), False)
+        received = []
+        try:
+            relay.selector.register(sender, selectors.EVENT_READ)
+            data = message(1, 0, words(2))
+            relay.queue(sender, data, [transferred_fd])
+            relay.flush(sender)
+            with self.assertRaises(OSError):
+                os.fstat(transferred_fd)
+            payload, ancillary, _, _ = receiver.recvmsg(1024, socket.CMSG_SPACE(4))
+            self.assertEqual(payload, data)
+            values = array.array('i')
+            values.frombytes(ancillary[0][2])
+            received.extend(values)
+            os.write(write_fd, b'gpu-fd')
+            self.assertEqual(os.read(received[0], 6), b'gpu-fd')
+        finally:
+            for fd in received + [read_fd, write_fd]:
+                os.close(fd)
+            sender.close()
+            receiver.close()
+            relay.server.close()
+            relay.selector.close()
+
+
