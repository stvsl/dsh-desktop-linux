@@ -0,0 +1,82 @@
+/** Sandboxed traffic lights; no command or Node bridge is exported to the application page. */
+import { ipcRenderer } from 'electron'
+import { LINUX_CHROME_ARGUMENT, LINUX_CHROME_IPC, type LinuxChromeState } from './linux-chrome-ipc.ts'
+
+/** Mounts only in the primary, explicitly marked application frame. */
+export function installLinuxChrome(): void {
+  if (!process.isMainFrame || !process.argv.includes(LINUX_CHROME_ARGUMENT)
+    || location.protocol !== 'dsh-app:' || location.hostname !== 'app') return
+  const radiusArgument = process.argv.find(argument => argument.startsWith('--dsh-desktop-corner-radius='))?.split('=')[1]
+  const radius = radiusArgument !== undefined && /^\d{1,2}$/u.test(radiusArgument) && Number(radiusArgument) <= 32 ? Number(radiusArgument) : 0
+  let state: LinuxChromeState = { maximized: false, fullscreen: false, focused: true }
+  let host: HTMLElement | undefined
+  let maximize: HTMLButtonElement | undefined
+  const zh = (): boolean => document.documentElement.lang.toLowerCase().startsWith('zh') || navigator.language.startsWith('zh')
+  const label = (action: string): string => {
+    const labels = zh()
+      ? { close: '关闭窗口（保留托盘）', minimize: '最小化窗口', maximize: '最大化窗口', restore: '还原窗口' }
+      : { close: 'Close window (keep in tray)', minimize: 'Minimize window', maximize: 'Maximize window', restore: 'Restore window' }
+    return labels[action as keyof typeof labels] ?? action
+  }
+  const update = (): void => {
+    document.documentElement.toggleAttribute('data-kde-glass-maximized', state.maximized)
+    document.documentElement.toggleAttribute('data-kde-glass-fullscreen', state.fullscreen)
+    if (host !== undefined) {
+      host.hidden = state.fullscreen
+      host.toggleAttribute('data-inactive', !state.focused)
+    }
+    if (maximize !== undefined) {
+      const text = label(state.maximized ? 'restore' : 'maximize')
+      maximize.title = text; maximize.setAttribute('aria-label', text)
+    }
+  }
+  ipcRenderer.on(LINUX_CHROME_IPC.state, (_event, value: unknown) => {
+    if (typeof value !== 'object' || value === null || !('maximized' in value) || typeof value.maximized !== 'boolean'
+      || !('fullscreen' in value) || typeof value.fullscreen !== 'boolean' || !('focused' in value) || typeof value.focused !== 'boolean') return
+    state = { maximized: value.maximized, fullscreen: value.fullscreen, focused: value.focused }; update()
+  })
+  const install = (): void => {
+    if (document.querySelector('dsh-kde-window-controls') !== null) return
+    document.documentElement.setAttribute('data-dsh-kde-glass-chrome', '')
+    const style = document.createElement('style')
+    style.textContent = `
+      html[data-dsh-kde-glass-chrome] { clip-path:inset(0 round ${radius}px); background:transparent !important; min-height:100%; }
+      html[data-dsh-kde-glass-chrome][data-kde-glass-maximized], html[data-dsh-kde-glass-chrome][data-kde-glass-fullscreen] { clip-path:inset(0 round 0px); }
+      html[data-dsh-kde-glass-chrome] [data-shell-leading] { left:88px !important; }
+      html[data-dsh-kde-glass-chrome] [data-sidebar-collapsed], html[data-dsh-kde-glass-chrome] [data-sidebar-drawer] { --dsh-frame-leading-clearance:160px !important; }
+      html[data-dsh-kde-glass-chrome][data-kde-glass-fullscreen] [data-shell-leading] { left:12px !important; }
+      html[data-dsh-kde-glass-chrome][data-kde-glass-fullscreen] [data-sidebar-collapsed], html[data-dsh-kde-glass-chrome][data-kde-glass-fullscreen] [data-sidebar-drawer] { --dsh-frame-leading-clearance:84px !important; }
+      html[data-dsh-kde-glass-chrome] [data-window-drag] { -webkit-app-region:drag !important; }
+      html[data-dsh-kde-glass-chrome] [data-window-drag] :is(button,a,input,textarea,select,[role=button],[contenteditable=true]), html[data-dsh-kde-glass-chrome] [data-shell-leading] { -webkit-app-region:no-drag !important; }
+    `
+    document.head.append(style)
+    host = document.createElement('dsh-kde-window-controls')
+    const shadow = host.attachShadow({ mode: 'closed' })
+    const chromeStyle = document.createElement('style')
+    chromeStyle.textContent = `
+      :host { position:fixed; top:12px; left:10px; width:66px; height:24px; display:flex; align-items:center; z-index:1100; -webkit-app-region:no-drag; user-select:none; }
+      :host([hidden]) { display:none; }
+      button { appearance:none; display:grid; place-items:center; flex:none; width:22px; height:24px; padding:0; border:0; background:transparent; cursor:default; -webkit-app-region:no-drag; border-radius:5px; }
+      button::before { content:""; grid-area:1/1; width:12px; height:12px; border-radius:50%; background:var(--dot); box-shadow:inset 0 0 0 .6px #0002; }
+      button span { grid-area:1/1; display:grid; place-items:center; width:12px; height:12px; font:600 11px/12px sans-serif; color:#0009; opacity:0; pointer-events:none; }
+      :host(:hover) span, button:focus-visible span { opacity:1; }
+      button:focus-visible { outline:2px solid #5b8eff; outline-offset:1px; }
+      button:active::before { filter:brightness(.8); }
+      :host([data-inactive]:not(:hover)) button::before { background:#92959b88; }
+    `
+    shadow.append(chromeStyle)
+    for (const [action, dot, symbol] of [['close', '#ff5f57', '×'], ['minimize', '#febc2e', '−'], ['maximize', '#28c840', '+']] as const) {
+      const button = document.createElement('button')
+      button.type = 'button'; button.title = label(action); button.setAttribute('aria-label', button.title)
+      button.dataset.action = action; button.style.setProperty('--dot', dot)
+      const glyph = document.createElement('span'); glyph.textContent = symbol; glyph.setAttribute('aria-hidden', 'true')
+      button.append(glyph)
+      button.addEventListener('click', event => { if (event.isTrusted) ipcRenderer.send(LINUX_CHROME_IPC.action, action) })
+      shadow.append(button)
+      if (action === 'maximize') maximize = button
+    }
+    document.body.append(host); update()
+  }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', install, { once: true })
+  else install()
+}
