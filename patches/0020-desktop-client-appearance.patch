+++ b/apps/desktop/tests/wayland-bootstrap.spec.ts
@@ -0,0 +1,60 @@
+import { EventEmitter } from 'node:events'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { DEFAULT_CLIENT_APPEARANCE } from '../src/client-appearance.ts'
+import { launchWaylandProxy, prepareAppearanceRestart, waylandProxyPython } from '../src/wayland-bootstrap.ts'
+
+const native = vi.hoisted(() => ({
+  releaseSingleInstanceLock: vi.fn(), relaunch: vi.fn(), exists: vi.fn(() => true), write: vi.fn(async () => {}),
+  spawn: vi.fn(),
+}))
+vi.mock('electron', () => ({ app: native }))
+vi.mock('node:child_process', () => ({ spawn: native.spawn }))
+vi.mock('node:fs', () => ({ existsSync: native.exists }))
+vi.mock('node:fs/promises', () => ({ writeFile: native.write }))
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+  vi.stubEnv('DSH_WAYLAND_PROXY_ACTIVE', undefined)
+  vi.stubEnv('DSH_WAYLAND_PROXY_RESTART_FILE', undefined)
+  vi.stubEnv('WAYLAND_DISPLAY', 'wayland-1')
+  vi.stubEnv('ELECTRON_RUN_AS_NODE', '1')
+})
+
+afterEach(() => { vi.unstubAllEnvs(); vi.restoreAllMocks() })
+
+it('launches bundled Python with one isolated Wayland relay and releases only its own initial lock', async () => {
+  const child = Object.assign(new EventEmitter(), { unref: vi.fn() })
+  native.spawn.mockImplementation(() => { queueMicrotask(() => child.emit('spawn')); return child })
+  await expect(launchWaylandProxy(DEFAULT_CLIENT_APPEARANCE, {python:'/bundle/python3',proxy:'/bundle/proxy.py'})).resolves.toBe(true)
+  expect(native.releaseSingleInstanceLock).toHaveBeenCalledOnce()
+  expect(native.spawn).toHaveBeenCalledWith('/bundle/python3',expect.arrayContaining([
+    '/bundle/proxy.py','--surface-title','DeepSeek Harness — Workspace','--corner-radius','12','--shadow','--',process.execPath,
+  ]),expect.objectContaining({detached:true,stdio:'inherit',env:expect.not.objectContaining({ELECTRON_RUN_AS_NODE:'1'})}))
+  expect(child.unref).toHaveBeenCalledOnce()
+})
+
+it('does not rewrap the supervised child or a non-frameless application', async () => {
+  vi.stubEnv('DSH_WAYLAND_PROXY_ACTIVE','1')
+  expect(await launchWaylandProxy(DEFAULT_CLIENT_APPEARANCE,{python:'/x',proxy:'/y'})).toBe(false)
+  vi.stubEnv('DSH_WAYLAND_PROXY_ACTIVE',undefined)
+  expect(await launchWaylandProxy({...DEFAULT_CLIENT_APPEARANCE,frameless:false,sidebarGlass:false},{python:'/x',proxy:'/y'})).toBe(false)
+  expect(native.spawn).not.toHaveBeenCalled()
+})
+
+it('uses the same private supervisor for a saved restart rather than inheriting a dead socket through app.relaunch', async () => {
+  vi.stubEnv('DSH_WAYLAND_PROXY_ACTIVE','1')
+  vi.stubEnv('DSH_WAYLAND_PROXY_RESTART_FILE','/private/restart.json')
+  await prepareAppearanceRestart({...DEFAULT_CLIENT_APPEARANCE,cornerRadius:24,systemShadow:false,sidebarGlass:false})
+  expect(native.write).toHaveBeenCalledWith('/private/restart.json',JSON.stringify({cornerRadius:24,systemShadow:false,waylandBlur:false}),{mode:0o600})
+  expect(native.relaunch).not.toHaveBeenCalled()
+  native.write.mockRejectedValueOnce(new Error('storage failure'))
+  await expect(prepareAppearanceRestart(DEFAULT_CLIENT_APPEARANCE)).rejects.toThrow('storage failure')
+  expect(native.relaunch).not.toHaveBeenCalled()
+})
+
+it('uses Electron relaunch outside a supervised Wayland process', async () => {
+  await prepareAppearanceRestart(DEFAULT_CLIENT_APPEARANCE)
+  expect(native.relaunch).toHaveBeenCalledOnce()
+  expect(waylandProxyPython('/runtime')).toBe('/runtime/dependencies/python/bin/python3')
+})
diff --git a/apps/desktop/tests/wayland/run_native_smoke.py b/apps/desktop/tests/wayland/run_native_smoke.py
new file mode 100644
index 00000000..46404083
--- /dev/null
+++ b/apps/desktop/tests/wayland/run_native_smoke.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Owned Electron/KWin smoke; requires --electron and never changes a live app.
+
+Creates a private runtime copy and profile, tests a frameless native surface plus
+an opaque settings window, then resizes/maximizes/fullscreens/restores the owned
+window. --screenshot uses Spectacle on only this focused test window. The caller
+must explicitly choose the compositor socket through --upstream.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import selectors
+import signal
+import subprocess
+import tempfile
+import time
+
+APP = r'''
+const {app, BrowserWindow, ipcMain} = require('electron');
+const fs = require('node:fs');
+const path = require('node:path');
+app.setName('dsh-native-appearance-smoke');
+app.setPath('userData', process.env.SMOKE_PROFILE);
+ipcMain.on('sandbox', (_event, value) => console.log('SMOKE sandbox=' + value));
+app.whenReady().then(() => {
+ const window = new BrowserWindow({width:360,height:240,frame:false,transparent:true,
+   hasShadow:false,backgroundColor:'#00000000',title:'DeepSeek Harness',show:false,
+   webPreferences:{sandbox:true,contextIsolation:true,nodeIntegration:false,preload:path.join(__dirname,'preload.js')}});
+ if (typeof window.contentView.setBorderRadius === 'function') window.contentView.setBorderRadius(16);
+ console.log('SMOKE alphaClip=' + (typeof window.contentView.setBorderRadius === 'function'));
+ window.loadURL('data:text/html,' + encodeURIComponent('<title>DeepSeek Harness</title><style>html{clip-path:inset(0 round 16px);background:transparent!important;min-height:100%}body{margin:0;background:rgba(34,42,58,.48);color:white;font:18px sans-serif}main{padding:26px;animation:pulse .3s infinite alternate}@keyframes pulse{to{opacity:.95}}</style><main>KWin native appearance<br><small>Sandboxed test window</small></main>'));
+ window.once('ready-to-show', () => {window.show(); console.log('SMOKE ready');});
+ let settings = new BrowserWindow({width:160,height:100,frame:true,transparent:false,title:'Settings smoke',show:false,webPreferences:{sandbox:true}});
+ settings.loadURL('data:text/html,<title>Settings smoke</title>Opaque framed settings control');
+ settings.once('ready-to-show', () => settings.showInactive());
+ fs.watchFile(process.env.SMOKE_CONTROL,{interval:50},() => {
+  let stage; try {stage=fs.readFileSync(process.env.SMOKE_CONTROL,'utf8');} catch {return;}
+  if(stage==='focus') {if(settings){settings.close();settings=null;} window.show(); window.focus(); window.webContents.executeJavaScript('new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)))').then(()=>console.log('SMOKE focused'));}
+  if(stage==='resize') {window.setSize(430,270); console.log('SMOKE resize');}
+  if(stage==='maximize') window.maximize();
+  if(stage==='restore') window.unmaximize();
+  if(stage==='fullscreen') window.setFullScreen(true);
+  if(stage==='unfullscreen') window.setFullScreen(false);
+  if(stage==='quit') app.quit();
+ });
+ window.on('maximize',()=>console.log('SMOKE maximized'));
+ window.on('unmaximize',()=>console.log('SMOKE restored'));
+ window.on('enter-full-screen',()=>console.log('SMOKE fullscreen'));
+ window.on('leave-full-screen',()=>console.log('SMOKE unfullscreen'));
+});
+app.on('window-all-closed',()=>app.quit());
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--electron', required=True, type=Path)
+    parser.add_argument('--upstream', required=True)
+    parser.add_argument('--output', required=True, type=Path)
+    parser.add_argument('--screenshot', type=Path)
+    parser.add_argument('--no-shadow', action='store_true')
+    parser.add_argument('--no-blur', action='store_true')
+    args = parser.parse_args()
+    source = args.electron.resolve()
+    proxy = Path(__file__).resolve().parents[2] / 'resources' / 'wayland_blur_proxy.py'
+    args.output.mkdir(parents=True, exist_ok=True)
+    log = args.output / 'protocol.log'
+    if log.exists():
+        parser.error('output protocol.log already exists; choose a new directory')
+    with tempfile.TemporaryDirectory(prefix='dsh-native-appearance-', dir=args.output.resolve()) as directory:
+        root = Path(directory)
+        runtime = root / 'runtime'
+        runtime.mkdir()
+        for item in source.parent.iterdir():
+            if item.name == 'resources':
+                continue
+            target = runtime / item.name
+            if item == source:
+                os.link(item, target)
+            else:
+                target.symlink_to(item, target_is_directory=item.is_dir())
+        app = runtime / 'resources' / 'app'
+        app.mkdir(parents=True)
+        (app / 'package.json').write_text('{"main":"main.js"}\n')
+        (app / 'main.js').write_text(APP)
+        (app / 'preload.js').write_text("require('electron').ipcRenderer.send('sandbox',process.sandboxed);\n")
+        control = root / 'control'
+        control.write_text('start')
+        env = {**os.environ, 'WAYLAND_DEBUG': 'client', 'SMOKE_PROFILE': str(root / 'profile'), 'SMOKE_CONTROL': str(control)}
+        env.pop('ELECTRON_RUN_AS_NODE', None)
+        env.pop('LD_PRELOAD', None)
+        command = ['python3', str(proxy), '--verbose', '--upstream', args.upstream,
+                   '--surface-title', 'DeepSeek Harness', '--corner-radius', '16',
+                   '--no-shadow' if args.no_shadow else '--shadow']
+        if args.no_blur:
+            command.append('--no-blur')
+        command.extend(['--', str(runtime / source.name), '--ozone-platform=wayland', '--user-data-dir=' + str(root / 'profile')])
+        process = subprocess.Popen(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
+        selector = selectors.DefaultSelector()
+        selector.register(process.stdout, selectors.EVENT_READ)
+        text = ''
+        deadline = time.monotonic() + 35
+        def until(predicate):
+            nonlocal text
+            while not predicate(text):
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError('native smoke stage did not finish')
+                ready = selector.select(remaining)
+                if not ready:
+                    raise TimeoutError('native smoke produced no stage evidence')
+                data = os.read(process.stdout.fileno(), 65536)
+                if not data:
+                    raise RuntimeError('Electron exited before stage evidence')
+                text += data.decode(errors='replace')
+                with log.open('a') as output:
+                    output.write(data.decode(errors='replace'))
+        try:
+            until(lambda value: 'SMOKE sandbox=true' in value and 'SMOKE ready' in value and
+                  (args.no_shadow or bool(re.search(r'org_kde_kwin_shadow@\d+\.commit\(\)', value))) and
+                  (args.no_blur or '.set_blur_region(' in value))
+            if args.screenshot:
+                control.write_text('focus')
+                until(lambda value: 'SMOKE focused' in value)
+                result = subprocess.run(['spectacle', '-b', '-n', '-a', '-o', str(args.screenshot.resolve())], capture_output=True, timeout=8)
+                if result.returncode or not args.screenshot.is_file():
+                    raise RuntimeError('Spectacle did not capture the owned test window')
+            for stage, marker in [('resize', 'SMOKE resize'), ('maximize', 'SMOKE maximized'),
+                                  ('restore', 'SMOKE restored'), ('fullscreen', 'SMOKE fullscreen'),
+                                  ('unfullscreen', 'SMOKE unfullscreen')]:
+                control.write_text(stage)
+                until(lambda value: marker in value)
+            control.write_text('quit')
+            result = process.wait(timeout=8)
+            remainder = process.stdout.read().decode(errors='replace')
+            text += remainder
+            with log.open('a') as output:
+                output.write(remainder)
+            if result != 0:
+                raise RuntimeError(f'proxy/Electron exit {result}')
+            if re.search(r'ERROR: wl_display|FATAL|Traceback', text):
+                raise RuntimeError('protocol or process error in smoke log')
+            creates = re.findall(r'org_kde_kwin_shadow_manager@\d+\.create', text)
+            unsets = re.findall(r'org_kde_kwin_shadow_manager@\d+\.unset', text)
+            if not args.no_shadow and (len(creates) < 2 or len(unsets) < 2):
+                raise RuntimeError('missing native shadow unset/restore transitions')
+            print(f'PASS sandbox=true exit=0 shadow_create={len(creates)} shadow_unset={len(unsets)} log={log}')
+        finally:
+            try:
+                os.killpg(process.pid, signal.SIGTERM)
