+++ b/apps/desktop/tests/client-settings-preload.spec.ts
@@ -0,0 +1,22 @@
+import { afterEach, expect, it, vi } from 'vitest'
+import { CLIENT_SETTINGS_IPC, type ClientSettingsApi } from '../src/client-settings-ipc.ts'
+
+const native = vi.hoisted(() => ({ expose: vi.fn(), invoke: vi.fn() }))
+vi.mock('electron', () => ({ contextBridge: { exposeInMainWorld: native.expose }, ipcRenderer: { invoke: native.invoke } }))
+afterEach(() => { vi.clearAllMocks(); vi.resetModules() })
+
+it('exposes only frozen get/save/restart wrappers without giving renderer generic IPC or Electron events', async () => {
+  await import('../src/preload-client-settings.ts')
+  expect(native.expose).toHaveBeenCalledOnce()
+  const [name, api] = native.expose.mock.calls[0]! as [string, ClientSettingsApi]
+  expect(name).toBe('dshClientSettings')
+  expect(Object.keys(api).sort()).toEqual(['get', 'restart', 'save'])
+  expect(Object.isFrozen(api)).toBe(true)
+  await api.get()
+  const input = { cornerRadius: 12 }
+  await api.save(input)
+  await api.restart()
+  expect(native.invoke.mock.calls).toEqual([
+    [CLIENT_SETTINGS_IPC.get], [CLIENT_SETTINGS_IPC.save, input], [CLIENT_SETTINGS_IPC.restart],
+  ])
+})
diff --git a/apps/desktop/tests/client-settings-renderer.spec.ts b/apps/desktop/tests/client-settings-renderer.spec.ts
new file mode 100644
index 00000000..26f44385
--- /dev/null
+++ b/apps/desktop/tests/client-settings-renderer.spec.ts
@@ -0,0 +1,136 @@
+// @vitest-environment jsdom
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { DEFAULT_CLIENT_APPEARANCE } from '../src/client-appearance.ts'
+import { readClientSettingsMessages } from '../src/client-settings-messages.ts'
+import type { ClientSettingsApi, ClientSettingsReply, ClientSettingsSnapshot } from '../src/client-settings-ipc.ts'
+
+const rendererPath = join(import.meta.dirname, '../renderer/client-settings.html')
+const html = readFileSync(rendererPath, 'utf8')
+const script = readFileSync(join(import.meta.dirname, '../renderer/client-settings.js'), 'utf8')
+let api: { [K in keyof ClientSettingsApi]: ReturnType<typeof vi.fn<ClientSettingsApi[K]>> }
+let reply: ClientSettingsReply<ClientSettingsSnapshot>
+
+function input(id: string) { return document.getElementById(id) as HTMLInputElement }
+function button(id: string) { return document.getElementById(id) as HTMLButtonElement }
+function text(id: string) { return document.getElementById(id)!.textContent }
+function edit(id: string, value: string) { input(id).value = value; input(id).dispatchEvent(new Event('input', { bubbles: true })) }
+function submit() { document.getElementById('appearance-form')!.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true })) }
+
+async function boot(locale: string = 'en') {
+  const copy = await readClientSettingsMessages(rendererPath, locale)
+  reply = { ...copy, kind: 'ok', value: {
+    current: DEFAULT_CLIENT_APPEARANCE, saved: DEFAULT_CLIENT_APPEARANCE, defaults: DEFAULT_CLIENT_APPEARANCE, restartRequired: false,
+  } }
+  api = { get: vi.fn().mockResolvedValue(reply), save: vi.fn().mockResolvedValue(reply),
+    restart: vi.fn().mockResolvedValue({ ...copy, kind: 'ok', value: { restarted: false } }) }
+  Object.defineProperty(window, 'dshClientSettings', { value: api, configurable: true })
+  window.eval(script)
+  await vi.waitFor(() => { expect(button('save').disabled).toBe(false) })
+}
+
+beforeEach(() => { document.documentElement.innerHTML = html.replace(/<!doctype html>/iu, '').replace(/<\/?html[^>]*>/gu, '') })
+afterEach(() => { vi.restoreAllMocks(); document.documentElement.innerHTML = '' })
+
+it('uses only external scripts/styles and denies inline handlers, network, frames and forms through CSP', () => {
+  const csp = document.querySelector('meta[http-equiv="Content-Security-Policy"]')!.getAttribute('content')!
+  expect(csp).toContain("default-src 'none'")
+  expect(csp).toContain("script-src 'self'")
+  expect(csp).toContain("style-src 'self'")
+  expect(csp).not.toContain('unsafe-inline')
+  expect(csp).toContain("frame-src 'none'")
+  expect(csp).toContain("form-action 'none'")
+  for (const element of document.querySelectorAll('*')) {
+    for (const name of element.getAttributeNames()) expect(name).not.toMatch(/^on/iu)
+    expect(element.getAttribute('style')).toBeNull()
+  }
+  expect([...document.scripts].every(node => node.src !== '' && node.textContent === '')).toBe(true)
+})
+
+it.each(['en', 'zh-CN'])('localizes copy and accessible number/range labels for %s without replacing controls', async locale => {
+  await boot(locale)
+  expect(document.documentElement.lang).toBe(locale)
+  expect(document.title).toBe(reply.messages.title)
+  for (const node of document.querySelectorAll('[data-message]')) expect(node.textContent).not.toBe('')
+  expect(input('corner-radius-range').getAttribute('aria-label')).toBe(reply.messages.cornerValue)
+  expect(input('sidebar-transparency-range').getAttribute('aria-label')).toBe(reply.messages.transparencyValue)
+  const original = input('corner-radius')
+  edit('corner-radius-range', '20')
+  expect(input('corner-radius')).toBe(original)
+  expect(original.value).toBe('20')
+  expect(text('status')).toBe(reply.messages.edited)
+})
+
+it('shows an independent localized failure if the isolated preload cannot connect', async () => {
+  Object.defineProperty(window, 'dshClientSettings', { value: undefined, configurable: true })
+  window.eval(script)
+  await vi.waitFor(() => { expect(document.getElementById('error')!.hidden).toBe(false) })
+  expect(text('error')).toContain('Client settings are unavailable')
+  expect(document.getElementById('appearance-form')!.hidden).toBe(true)
+  expect(document.querySelector('footer')!.hidden).toBe(true)
+})
+
+it('inverts transparency to stored opacity and does not restart on an ordinary save', async () => {
+  await boot()
+  edit('sidebar-transparency', '80')
+  edit('corner-radius', '0')
+  expect(input('sidebar-transparency-range').value).toBe('80')
+  submit()
+  await vi.waitFor(() => { expect(api.save).toHaveBeenCalledOnce() })
+  expect(api.save).toHaveBeenCalledWith({ ...DEFAULT_CLIENT_APPEARANCE, cornerRadius: 0, sidebarOpacity: 20 })
+  expect(api.restart).not.toHaveBeenCalled()
+})
+
+it('holds the same draft on structured save failure and blocks duplicate submissions while pending', async () => {
+  await boot()
+  edit('corner-radius', '7')
+  const pending = Promise.withResolvers<ClientSettingsReply<ClientSettingsSnapshot>>()
+  api.save.mockReturnValueOnce(pending.promise)
+  submit()
+  submit()
+  button('save-restart').click()
+  expect(api.save).toHaveBeenCalledOnce()
+  expect(button('save').disabled).toBe(true)
+  expect(button('restore').disabled).toBe(true)
+  expect(input('corner-radius').value).toBe('7')
