+  expect(f.restart).not.toHaveBeenCalled()
+  const dialog = native.dialog.mock.calls[0]![1]
+  expect(dialog).toMatchObject({ defaultId: 0, cancelId: 0 })
+  expect(dialog.detail).toContain('Host tasks will be interrupted')
+  expect(dialog.buttons).toEqual(['Cancel', 'Interrupt tasks and restart'])
+  native.dialog.mockResolvedValueOnce({ response: 1 })
+  expect(await f.restartNow()).toMatchObject({ kind: 'ok', value: { restarted: true } })
+  expect(f.restart).toHaveBeenCalledOnce()
+})
+
+it.each(['close', 'dispose'] as const)('invalidates a pending native confirmation on %s and never restarts a reopened window', async reason => {
+  const f = await fixture()
+  await manager!.open()
+  const answer = Promise.withResolvers<{ response: number }>()
+  native.dialog.mockReturnValueOnce(answer.promise)
+  const pending = f.restartNow()
