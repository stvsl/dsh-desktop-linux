+// @vitest-environment jsdom
+import { afterEach, expect, it } from 'vitest'
+import { glassDocument } from '../src/glass-document.ts'
+
+afterEach(() => {
+  document.documentElement.removeAttribute('data-dsh-glass')
+  document.body.removeAttribute('data-ds-dark-theme')
+  document.head.innerHTML = ''
+  document.body.innerHTML = ''
+})
+
+function sidebarFixture() {
+  // Same scrollport / decorative sibling as SidebarRoot, independent of CSS Module hashes.
+  document.body.innerHTML = `<div class="v1_sidebarCol"><div><div data-sidebar-scrollport></div><span class="v2_scrollFade" aria-hidden="true"></span></div><footer>Footer</footer></div>
+    <main><div data-sidebar-scrollport></div><span class="v2_scrollFade" aria-hidden="true"></span></main>`
+  const style = document.createElement('style')
+  style.textContent = '.v2_scrollFade { display: block; height: 24px; }'
+  document.head.append(style)
+  const sidebarFade = document.querySelector('.v1_sidebarCol span')!
+  const contentFade = document.querySelector('main span')!
+  return { sidebarFade, contentFade }
+}
+
+for (const dark of [false, true]) it(`removes only the opaque sidebar scroll fade over ${dark ? 'dark' : 'light'} glass`, () => {
+  const { sidebarFade, contentFade } = sidebarFixture()
+  expect(getComputedStyle(sidebarFade).display).toBe('block')
+  // The former _fade suffix never matched the actual scrollFade class.
+  expect(sidebarFade.matches('[class$="_fade"]')).toBe(false)
+  document.documentElement.setAttribute('data-dsh-glass', '')
+  document.body.toggleAttribute('data-ds-dark-theme', dark)
+  const style = document.createElement('style')
+  style.textContent = glassDocument(80).split('<style>')[1]!.split('</style>')[0]!
+  document.head.append(style)
+  expect(getComputedStyle(sidebarFade).display).toBe('none')
+  expect(getComputedStyle(contentFade).display).toBe('block')
+  expect(getComputedStyle(document.querySelector('footer')!).display).not.toBe('none')
+  document.documentElement.removeAttribute('data-dsh-glass')
+  expect(getComputedStyle(sidebarFade).display).toBe('block')
+})
