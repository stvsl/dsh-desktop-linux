diff --git a/apps/desktop/src/glass-document.ts b/apps/desktop/src/glass-document.ts
index 1b4a4f29..71d01ee5 100644
--- a/apps/desktop/src/glass-document.ts
+++ b/apps/desktop/src/glass-document.ts
@@ -46,6 +46,15 @@ html[data-dsh-glass] body { isolation: isolate; }
    sidebar-browser frames. */
 html[data-dsh-glass] div:has(> [class*="sidebarCol"]) { background: transparent; }
 
+/* The Windows content radius exposes its frame at the caption/column junction. Back only the
+   content-side strip with the caption fill, leaving the sidebar and exterior corners transparent. */
+html[data-dsh-glass][data-windows-titlebar] div:has(> [class*="sidebarCol"]) {
+  background-image: linear-gradient(var(--dsw-specific-sidebar-fill), var(--dsw-specific-sidebar-fill));
+  background-repeat: no-repeat;
+  background-position: right var(--dsh-windows-titlebar-height);
+  background-size: calc(100% - var(--dsh-windows-sidebar-width)) var(--dsh-windows-content-radius);
+}
+
 /* Chromium cannot blur a menu over a transparent window: without an opaque backing the menu's
    translucent fill shows the sidebar text straight through it. macOS ships this backing for the
    same reason (MenuSurface, darwin only), so glass mode shows it too. */
