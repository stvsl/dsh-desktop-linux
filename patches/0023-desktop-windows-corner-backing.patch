@@ -27,6 +27,14 @@ describe('glassDocument', () => {
     expect(markup).not.toContain('[class*="_frame"]')
   })
 
+  it('backs only the Windows content-side corner using the owning frame dimensions', () => {
+    const markup = glassDocument(80)
+    expect(markup).toContain('html[data-dsh-glass][data-windows-titlebar] div:has(> [class*="sidebarCol"]) {')
+    expect(markup).toContain('background-position: right var(--dsh-windows-titlebar-height);')
+    expect(markup).toContain('background-size: calc(100% - var(--dsh-windows-sidebar-width)) var(--dsh-windows-content-radius);')
+    expect(markup).not.toContain('border-radius:')
+  })
+
   it('uses the macOS fills by default and one tint for both themes', () => {
     const macOS = glassDocument(null)
     expect(macOS).toContain('#7a9bf0) 40%, transparent)')
